VAPI_API_KEY=
# Vapi id of the outbound caller number (a Twilio number imported into Vapi; free Vapi numbers cannot dial out)
VAPI_PHONE_NUMBER_ID=
EXA_API_KEY=
JEV_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
# Public URL of this app incl. base path, used for Vapi webhooks and demo-line TwiML
PUBLIC_BASE_URL=https://your-public-url
NEXT_PUBLIC_BASE_PATH=
# Demo support line: Twilio number whose Voice URL is $PUBLIC_BASE_URL/api/demo-line
DEMO_LINE_NUMBER=+1...
# Vapi number answered by the AI "rep" (scripts/setup-demo-rep.mjs)
DEMO_REP_NUMBER=+1...
DEMO_REP_PHONE_NUMBER_ID=
