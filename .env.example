# CallEnvoy service env (names only; real values live in .env on the server, chmod 600)
# Optional, old single key: imported once as the first agent key when the key list is empty, then not needed.
# New keys are made in the console (Agents).
CALLENVOY_API_KEY=
# The admin's address (sees usage of all users, can disable / remove users, switches sign-ups on or off).
# Required to upgrade a database from before user accounts: its data is given to this user.
OWNER_EMAIL=
# Console sign-in by a one-time email link, for any address (without them: uv run python -m callenvoy.signin [email])
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Public URL including the base path; used for webhook / wss URLs and Twilio signature checks
PUBLIC_BASE_URL=https://pragnyalabs.com/callenvoy
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The CallEnvoy outbound number (E.164)
TWILIO_FROM_NUMBER=+19186021019
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
FISH_API_KEY=
# Web push (optional; make with: uv run python -m callenvoy.push --make-keys). Without them push is off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Local development only: skips the client/dist check and allows the Expo web dev origin
# CALLENVOY_DEV=1
