# systemd unit for CallEnvoy. Installed as "holdforme.service" (same unit name as before, one thing to restart).
# One worker only: live call state is in memory.
[Unit]
Description=CallEnvoy (holdforme)
After=network-online.target
Wants=network-online.target

[Service]
User=agent
WorkingDirectory=/home/agent/apps/holdforme
EnvironmentFile=/home/agent/apps/holdforme/.env
ExecStart=/home/agent/.local/bin/uv run --frozen --no-dev uvicorn callenvoy.main:app --host 127.0.0.1 --port 3020 --no-access-log
Restart=always
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
